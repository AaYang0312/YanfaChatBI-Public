PORT=3000 # Backend Port
IS_DOCKER=true # true/false
ENVIRONMENT=DEVELOPMENT # DEVELOPMENT, PRODUCTION
MAX_CHATS_PER_USER=1 # 0 for trial mode(2 connections), 1 for unlimited
CORS_ALLOWED_ORIGIN=http://localhost:5173 # Frontend exposed base url
YANFA_ADMIN_USERNAME=admin # Change before first start
YANFA_ADMIN_PASSWORD=change-me # Change before first start
SCHEMA_ENCRYPTION_KEY=change-me-32-bytes-random-key # Encrypts connection credentials and model API keys
JWT_SECRET=change-me-to-a-random-secret
USER_JWT_EXPIRATION_MILLISECONDS=1000*60*10 # 10 minutes
USER_JWT_REFRESH_EXPIRATION_MILLISECONDS=1000*60*60*24*10 # 10 days

# Used for storing user, connections, chats etc
YANFA_MONGODB_URI=mongodb://yanfachatbi:yanfachatbi@yanfachatbi-mongodb:27017/yanfachatbi?authSource=admin
YANFA_MONGODB_NAME=yanfachatbi

# Used for storing user sessions, DB schema
YANFA_REDIS_HOST=yanfachatbi-redis
YANFA_REDIS_PORT=6379
YANFA_REDIS_USERNAME=yanfachatbi
YANFA_REDIS_PASSWORD=default

# Optional bootstrap provider (only used when MongoDB has no provider yet).
# Prefer configuring providers in the UI.
OPENAI_API_KEY=<openai-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_MODEL=gpt-4o
OPENAI_MAX_COMPLETION_TOKENS=30000 # Example: 30000
OPENAI_TEMPERATURE=1  # 0-2

# Example DB for Development Environment
EXAMPLE_DB_TYPE=
EXAMPLE_DB_HOST=
EXAMPLE_DB_PORT=
EXAMPLE_DB_NAME=
EXAMPLE_DB_USERNAME=
EXAMPLE_DB_PASSWORD=

# PostgreSQL for Spreadsheet (CSV/Excel) Data Storage
SPREADSHEET_POSTGRES_HOST=yanfachatbi-spreadsheet-postgres
SPREADSHEET_POSTGRES_PORT=5432
SPREADSHEET_POSTGRES_DATABASE=yanfachatbi_spreadsheet_storage
SPREADSHEET_POSTGRES_USERNAME=yanfachatbi
SPREADSHEET_POSTGRES_PASSWORD=yanfachatbi
SPREADSHEET_POSTGRES_SSL_MODE=disable # disable, require, verify-ca, verify-full

# Encryption for Spreadsheet data
SPREADSHEET_DATA_ENCRYPTION_KEY=spreadsheet_encryption_key_32byt # Must be exactly 32 characters for AES-GCM

# Google OAuth Configuration (used for both authentication and Google Sheets integration)
GOOGLE_CLIENT_ID=your-google-client-id.googleusercontent.com # Google OAuth Client ID
GOOGLE_CLIENT_SECRET=your-google-client-secret # Google OAuth Client Secret
GOOGLE_REDIRECT_URL=http://localhost:5173/auth/google/callback # Google OAuth Redirect URL

# Qdrant Vector DB Configuration (used for RAG pipeline)
QDRANT_HOST=yanfachatbi-qdrant # Qdrant host (use "yanfachatbi-qdrant" in Docker, "localhost" for local)
QDRANT_PORT=6334 # Qdrant gRPC port
QDRANT_API_KEY=yanfachatbi-qdrant-local-key
QDRANT_USE_TLS=false # Use TLS for Qdrant connection (set true for Qdrant Cloud)
QDRANT_SCHEMA_BM25_ENABLED=false # Independent schema BM25 retrieval; requires Qdrant 1.20+

# Embedding Model Configuration (used for RAG vectorization)
# Provider: only OpenAI-compatible endpoints are supported (auto-detected from the API key if empty)
# Models: text-embedding-3-small (default, 1536d), text-embedding-3-large (3072d), text-embedding-ada-002 (1536d)
EMBEDDING_PROVIDER=openai # openai-compatible (auto-detected if empty)
EMBEDDING_MODEL=text-embedding-3-small # e.g., text-embedding-3-small (uses provider default if empty)
# Keep any existing custom physical collection names during migration.
EMBEDDING_SCHEMA_COLLECTION=
EMBEDDING_MESSAGE_COLLECTION=
# PostgreSQL ordinary tables/views: off until isolated acceptance is complete.
QUERY_OBJECTS_ENABLED=false
# Blank derives <configured schema collection>_objects_v2; never reuse legacy/message collections.
EMBEDDING_OBJECT_SCHEMA_COLLECTION=

# Context compaction (long conversations) and result feedback
CONTEXT_COMPACTION_ENABLED=true # Fold older messages into a structured summary near the context budget
CONTEXT_COMPACTION_THRESHOLD=0.75 # Trigger when the estimated prompt exceeds this fraction of the budget
CONTEXT_COMPACTION_KEEP_TURNS=6 # Recent turns kept verbatim
CONTEXT_COMPACTION_MIN_MESSAGES=4 # Minimum messages eligible for folding
CONTEXT_SUMMARY_MAX_TOKENS=4000 # Summary size before secondary compression
CONTEXT_SUMMARY_MODEL= # Optional cheaper model for summaries (empty = default provider model)
RAG_AFTER_COMPACTION_TOP_K=3 # Extra retrieval over already summarized history
RESULT_DIGEST_MAX_CHARS=4000 # Per-query result digest budget
RESULT_DIGEST_TOTAL_MAX_CHARS=8000 # All digests in one prompt
